{% extends "layouts/main.html.twig" %}

{% block title %}Reabastecer Inventario{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Abastecimiento</h3>
    <div class="text-muted small">Registro de compras e incremento de inventario</div>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ base_url }}/purchases" class="btn btn-outline-primary">
      <i class="bi bi-cart-check me-1"></i> Compras
    </a>
    <a href="{{ base_url }}/inventory" class="btn btn-outline-secondary">
      <i class="bi bi-box-seam me-1"></i> Inventario
    </a>
  </div>
</div>

<div class="row g-4">
  <!-- Columna Izquierda: Buscador y Selección de Insumos -->
  <div class="col-lg-7">
    <!-- Buscador -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-search me-2 text-primary"></i>Buscar Insumo</h6>
      </div>
      <div class="card-body">
        <form method="get" action="{{ base_url }}/supply">
          <div class="input-group">
            <input type="text" name="q" class="form-control" placeholder="Buscar por nombre o código..." value="{{ searchQuery }}" autofocus>
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i> Buscar</button>
            {% if searchQuery %}
              <a href="{{ base_url }}/supply" class="btn btn-outline-secondary btn-sm">Limpiar</a>
            {% endif %}
          </div>
        </form>
      </div>
    </div>

    <!-- Resultados -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-egg-fried me-2 text-success"></i>Insumos</h6>
        <span class="badge bg-secondary">{{ searchResults|length }} insumos</span>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Código</th>
                <th>Insumo</th>
                <th>Unidad</th>
                <th class="text-end">Costo Unit.</th>
                <th class="text-center">Stock</th>
                <th style="width: 200px;" class="text-end pe-3">Agregar</th>
              </tr>
            </thead>
            <tbody>
              {% for ing in searchResults %}
                {% set stock = ing.getStock() %}
                <tr>
                  <td class="ps-3 fw-bold text-secondary">#{{ ing.code }}</td>
                  <td class="fw-semibold text-dark">{{ ing.name }}</td>
                  <td><span class="badge bg-light text-dark border">{{ ing.unit }}</span></td>
                  <td class="text-end fw-bold text-dark">${{ ing.price_in|number_format(2) }}</td>
                  <td class="text-center">
                    <span class="badge {% if stock <= 2 %}bg-danger{% elseif stock <= 5 %}bg-warning text-dark{% else %}bg-success{% endif %}">
                      {{ stock|number_format(2) }}
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <form method="post" action="{{ base_url }}/supply/add" class="d-flex gap-1 justify-content-end">
                      {{ csrf_field() }}
                      <input type="hidden" name="ingredient_id" value="{{ ing.id }}">
                      <input type="number" step="any" min="0.1" name="q" class="form-control form-control-sm text-center" style="width: 75px;" value="1" required>
                      <button type="submit" class="btn btn-xs btn-success text-white" title="Agregar a la compra">
                        <i class="bi bi-plus-lg"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">
                    No se encontraron insumos con el criterio de búsqueda.
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Lista / Carrito de Reabastecimiento -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 mb-4 sticky-top" style="top: 1rem;">
      <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-cart-check me-2"></i>Lista de Compra</h6>
        <span class="badge bg-white text-success fw-bold">{{ cartItems|length }} artículos</span>
      </div>
      <div class="card-body">
        <div class="table-responsive" style="max-height: 380px;">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Cant.</th>
                <th>Insumo</th>
                <th class="text-end">P. Unit.</th>
                <th class="text-end">Subtotal</th>
                <th class="text-center pe-3"></th>
              </tr>
            </thead>
            <tbody>
              {% for item in cartItems %}
                <tr>
                  <td class="ps-3 fw-bold text-dark">{{ item.q }} {{ item.ingredient.unit }}</td>
                  <td class="fw-semibold">{{ item.ingredient.name }}</td>
                  <td class="text-end">${{ item.ingredient.price_in|number_format(2) }}</td>
                  <td class="text-end fw-bold text-success">${{ item.subtotal|number_format(2) }}</td>
                  <td class="text-center pe-3">
                    <a href="{{ base_url }}/supply/remove/{{ item.ingredient.id }}" class="btn btn-xs btn-outline-danger" title="Quitar">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">
                    <i class="bi bi-cart-x fs-2 d-block text-muted opacity-50 mb-2"></i>
                    La lista de compra está vacía.
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% if cartItems|length > 0 %}
          <div class="p-3 bg-light border-top">
            <div class="d-flex justify-content-between mb-2 small text-muted">
              <span>Total de Artículos:</span>
              <span class="fw-bold text-dark">{{ cartItems|length }}</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fs-5 fw-bold text-dark">TOTAL COMPRA:</span>
              <span class="fs-4 fw-bold text-success">${{ total|number_format(2) }}</span>
            </div>

            <form method="post" action="{{ base_url }}/supply/process">
              {{ csrf_field() }}
              <button type="submit" class="btn btn-success w-100 fw-bold py-2 shadow-sm text-white">
                <i class="bi bi-check2-circle me-1"></i> Procesar Compra
              </button>
            </form>

            <div class="text-center mt-2">
              <a href="{{ base_url }}/supply/clear" class="text-danger small text-decoration-none" onclick="return confirm('¿Seguro que deseas vaciar la orden de compra?')">
                <i class="bi bi-trash me-1"></i> Vaciar toda la lista
              </a>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
