{% extends "layouts/main.html.twig" %}

{% block title %}Monitor de Mesas{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Monitor de Mesas</h3>
    <div class="text-muted small">Estado de ocupación de mesas</div>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ base_url }}/home" class="btn btn-outline-primary">
      <i class="bi bi-speedometer2 me-1"></i> Dashboard
    </a>
    <a href="{{ base_url }}/tables" class="btn btn-outline-secondary">
      <i class="bi bi-gear me-1"></i> Mesas
    </a>
    <a href="{{ base_url }}/reports" class="btn btn-outline-success">
      <i class="bi bi-cash-stack me-1"></i> Reportes
    </a>
  </div>
</div>

<!-- Tarjetas Métricas -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card text-white bg-primary shadow-sm border-0">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-white-50 small text-uppercase fw-semibold">Total de Mesas</div>
            <div class="fs-4 fw-bold mt-1">{{ totalTables }}</div>
          </div>
          <div class="avatar avatar-md bg-white bg-opacity-25 rounded text-white d-flex align-items-center justify-content-center">
            <i class="bi bi-table fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card text-white bg-danger shadow-sm border-0">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-white-50 small text-uppercase fw-semibold">Mesas Ocupadas</div>
            <div class="fs-4 fw-bold mt-1">{{ occupiedCount }}</div>
          </div>
          <div class="avatar avatar-md bg-white bg-opacity-25 rounded text-white d-flex align-items-center justify-content-center">
            <i class="bi bi-people-fill fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card text-white bg-success shadow-sm border-0">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-white-50 small text-uppercase fw-semibold">Mesas Disponibles</div>
            <div class="fs-4 fw-bold mt-1">{{ freeCount }}</div>
          </div>
          <div class="avatar avatar-md bg-white bg-opacity-25 rounded text-white d-flex align-items-center justify-content-center">
            <i class="bi bi-check-circle fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card text-white bg-warning shadow-sm border-0">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-dark small text-uppercase fw-semibold">Consumo Activo en Piso</div>
            <div class="fs-4 fw-bold mt-1 text-dark">${{ activeTotal|number_format(2) }}</div>
          </div>
          <div class="avatar avatar-md bg-dark bg-opacity-10 rounded text-dark d-flex align-items-center justify-content-center">
            <i class="bi bi-currency-dollar fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Cuadrícula de Mesas -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-header bg-white py-3">
    <h6 class="mb-0 fw-bold"><i class="bi bi-grid-fill me-2 text-danger"></i>Piso del Restaurante</h6>
  </div>
  <div class="card-body p-4">
    <div class="row g-3">
      {% for item in tables %}
        {% set t = item.table %}
        {% set occ = item.is_occupied %}
        {% set ord = item.order %}
        <div class="col-6 col-sm-4 col-md-3 col-xl-2">
          <div class="card border {% if occ %}border-danger bg-danger bg-opacity-10{% else %}border-success bg-success bg-opacity-10{% endif %} shadow-sm text-center h-100">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
              <div>
                <div class="badge {% if occ %}bg-danger{% else %}bg-success{% endif %} mb-2">
                  {% if occ %}OCUPADA{% else %}LIBRE{% endif %}
                </div>
                <h5 class="fw-bold mb-1">Mesa {{ t.name }}</h5>
                <div class="small text-muted mb-2">Cap: {{ t.capacity }} pers.</div>
              </div>

              <div>
                {% if occ %}
                  <div class="fw-bold text-danger fs-6 mb-2">
                    ${{ ord.getTotal()|number_format(2) }}
                  </div>
                  <a href="{{ base_url }}/orders/table/{{ t.id }}" class="btn btn-danger w-100">
                    <i class="bi bi-receipt me-1"></i> Comanda
                  </a>
                {% else %}
                  <button type="button" class="btn btn-success text-white w-100" 
                          data-coreui-toggle="modal" data-coreui-target="#openTableModal" 
                          onclick="prepareOpenTable('{{ t.id }}', '{{ t.name|e('js') }}', '{{ t.capacity }}')">
                    <i class="bi bi-plus-circle me-1"></i> Abrir Mesa
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% else %}
        <div class="col-12 text-center py-4 text-muted">
          No hay mesas configuradas. Agrega mesas desde la sección de administración.
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Modal Abrir Mesa -->
<div class="modal fade" id="openTableModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form method="post" action="{{ base_url }}/orders/open">
        {{ csrf_field() }}
        <input type="hidden" name="table_id" id="open_table_id">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="openModalTitle">Abrir Mesa</h5>
          <button type="button" class="btn-close" data-coreui-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Cantidad de Comensales</label>
            <input type="number" name="q" id="open_q" class="form-control form-control-sm" min="1" max="30" value="2" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-coreui-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success text-white">Comenzar Orden</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function prepareOpenTable(id, name, cap) {
  document.getElementById('open_table_id').value = id;
  document.getElementById('openModalTitle').textContent = 'Abrir Mesa ' + name;
  document.getElementById('open_q').value = cap || 2;
}
</script>
{% endblock %}
