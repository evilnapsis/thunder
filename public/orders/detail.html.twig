{% extends "layouts/main.html.twig" %}

{% block title %}Detalle de Orden #{{ order.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Detalle de Comanda #{{ order.id }}</h3>
    <div class="text-muted small">Mesa: {{ order.getTable().name|default('Barra / N/A') }} | Fecha: {{ order.created_at }}</div>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ base_url }}/home" class="btn btn-outline-secondary">
      <i class="bi bi-speedometer2 me-1"></i> Dashboard
    </a>
    <a href="{{ base_url }}/orders" class="btn btn-outline-primary">
      <i class="bi bi-receipt me-1"></i> Lista de Órdenes
    </a>
    <button type="button" class="btn btn-outline-dark" onclick="window.print();">
      <i class="bi bi-printer me-1"></i> Imprimir Ticket
    </button>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2 text-primary"></i>Consumos</h6>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Cant.</th>
                <th>Platillo / Bebida</th>
                <th class="text-end">Precio Unit.</th>
                <th class="text-end pe-3">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              {% for op in order.getOperations() %}
                {% set p = op.getProduct() %}
                <tr>
                  <td class="ps-3 fw-bold">{{ op.q|number_format(0) }}</td>
                  <td>
                    <div class="fw-bold">{{ p.name|default('Platillo no disponible') }}</div>
                    <div class="small text-muted">{{ p.presentation|default(p.unit) }}</div>
                  </td>
                  <td class="text-end">${{ p.price_out|default(0)|number_format(2) }}</td>
                  <td class="text-end pe-3 fw-bold text-dark">
                    ${{ (op.q * (p.price_out|default(0)))|number_format(2) }}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="4" class="text-center py-4 text-muted">No se registraron productos en esta orden.</td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot class="table-light">
              <tr>
                <td colspan="3" class="text-end fw-bold fs-5">TOTAL PAGADO:</td>
                <td class="text-end pe-3 fw-bold fs-4 text-success">${{ order.getTotal()|number_format(2) }}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Información de la Cuenta</h6>
      </div>
      <div class="card-body p-3">
        <ul class="list-group list-group-flush small">
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Estado:</span>
            <span class="badge {% if order.is_applied %}bg-success{% else %}bg-warning text-dark{% endif %}">
              {% if order.is_applied %}Cobrada / Cerrada{% else %}Abierta en Piso{% endif %}
            </span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Mesa:</span>
            <span class="fw-bold">Mesa {{ order.getTable().name|default('N/A') }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Comensales:</span>
            <span class="fw-bold">{{ order.q }} personas</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Mesero:</span>
            <span>{{ order.getMesero().name|default('N/A') }} {{ order.getMesero().lastname|default('') }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Cajero / Cobrado por:</span>
            <span>{{ order.getCajero().name|default('N/A') }} {{ order.getCajero().lastname|default('') }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Fecha y Hora:</span>
            <span>{{ order.created_at }}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
{% endblock %}
