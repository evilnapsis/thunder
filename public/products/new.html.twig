{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Platillo{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="fw-bold mb-0">Nuevo Platillo / Bebida</h3>
    <div class="text-muted small">Agrega un nuevo elemento al menú del restaurante</div>
  </div>
  <a href="{{ base_url }}/products" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Volver al Menú
  </a>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <form method="post" action="{{ base_url }}/products/create">
      {{ csrf_field() }}
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label small fw-semibold">Código / Clave</label>
          <input type="text" name="code" class="form-control form-control-sm" placeholder="Ej: TAC-01">
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Nombre del Platillo <span class="text-danger">*</span></label>
          <input type="text" name="name" class="form-control form-control-sm" placeholder="Ej: Orden de Tacos al Pastor" required>
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Categoría <span class="text-danger">*</span></label>
          <select name="category_id" class="form-select form-select-sm" required>
            <option value="">-- Seleccionar --</option>
            {% for c in categories %}
              <option value="{{ c.id }}">{{ c.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Precio de Venta ($) <span class="text-danger">*</span></label>
          <input type="number" step="0.01" name="price_out" class="form-control form-control-sm" placeholder="0.00" required>
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Costo Aproximado ($)</label>
          <input type="number" step="0.01" name="price_in" class="form-control form-control-sm" placeholder="0.00">
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Tiempo Estimado (min)</label>
          <input type="number" name="duration" class="form-control form-control-sm" value="10">
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Unidad de Medida</label>
          <input type="text" name="unit" class="form-control form-control-sm" value="orden">
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Imagen (Ruta / URL)</label>
          <input type="text" name="image" class="form-control form-control-sm" placeholder="Ej: storage/products/tacos.jpg">
        </div>

        <div class="col-12">
          <label class="form-label small fw-semibold">Descripción</label>
          <textarea name="description" rows="2" class="form-control form-control-sm" placeholder="Detalles de preparación o ingredientes"></textarea>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a href="{{ base_url }}/products" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger text-white">
          <i class="bi bi-check-circle me-1"></i> Guardar Platillo
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
