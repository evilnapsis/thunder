{% extends "layouts/main.html.twig" %}

{% block title %}Detalle de Compra #{{ purchase.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Detalle de Compra #{{ purchase.id }}</h3>
    <div class="text-muted small">Registro de compra | {{ purchase.created_at }}</div>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ base_url }}/purchases" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Compras
    </a>
    <a href="{{ base_url }}/supply" class="btn btn-success text-white">
      <i class="bi bi-cart-plus me-1"></i> Nueva Compra
    </a>
    <button type="button" class="btn btn-outline-dark" onclick="window.print();">
      <i class="bi bi-printer me-1"></i> Imprimir Comprobante
    </button>
  </div>
</div>

<div class="row g-4">
  <!-- Detalle de Insumos -->
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Insumos</h6>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Código</th>
                <th>Insumo</th>
                <th class="text-center">Cantidad</th>
                <th class="text-end">Costo Unit.</th>
                <th class="text-end pe-3">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              {% for op in operations %}
                {% set ing = op.getIngredient() %}
                <tr>
                  <td class="ps-3 text-secondary">#{{ ing.code|default('N/A') }}</td>
                  <td>
                    <div class="fw-bold">{{ ing.name|default('Insumo eliminado') }}</div>
                  </td>
                  <td class="text-center fw-bold text-dark">
                    {{ op.q|number_format(2) }} {{ ing.unit|default('') }}
                  </td>
                  <td class="text-end">${{ ing.price_in|default(0)|number_format(2) }}</td>
                  <td class="text-end pe-3 fw-bold text-success">
                    ${{ (op.q * (ing.price_in|default(0)))|number_format(2) }}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No hay insumos registrados en esta compra.</td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot class="table-light">
              <tr>
                <td colspan="4" class="text-end fw-bold fs-5">TOTAL DE LA COMPRA:</td>
                <td class="text-end pe-3 fw-bold fs-4 text-success">${{ total|number_format(2) }}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Información de la Compra -->
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Datos del Abastecimiento</h6>
      </div>
      <div class="card-body p-3">
        <ul class="list-group list-group-flush small">
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Folio de Compra:</span>
            <span class="fw-bold text-primary">#{{ purchase.id }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Responsable:</span>
            <span class="fw-bold">{{ purchase.getUser().name|default('Administrador') }} {{ purchase.getUser().lastname|default('') }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Insumos Comprados:</span>
            <span>{{ operations|length }} partidas</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Fecha y Hora:</span>
            <span>{{ purchase.created_at }}</span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-muted">Tipo de Movimiento:</span>
            <span class="badge bg-success">Entrada a Inventario</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
{% endblock %}
