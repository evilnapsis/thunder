{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Ingrediente{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Nuevo Ingrediente</h3>
    <div class="text-muted small">Registrar un nuevo insumo para el control de inventario</div>
  </div>
  <a href="{{ base_url }}/ingredients" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Volver a Lista
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>Datos del Ingrediente</h6>
      </div>
      <div class="card-body p-4">
        <form method="post" action="{{ base_url }}/ingredients/create">
          {{ csrf_field() }}

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Código *</label>
              <input type="text" name="code" class="form-control" placeholder="Ej. ING-01" required autofocus>
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Nombre del Ingrediente *</label>
              <input type="text" name="name" class="form-control" placeholder="Ej. Carne de Res, Jitomate, Tortillas..." required>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Costo Compra ($) *</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="price_in" class="form-control" placeholder="0.00" required>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Precio Referencial ($)</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="price_out" class="form-control" placeholder="0.00">
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Unidad de Medida *</label>
              <input type="text" name="unit" class="form-control" placeholder="Ej. kg, pz, lt, gr..." value="kg" required>
            </div>
          </div>

          <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" name="is_active" id="isActiveCheck" checked>
            <label class="form-check-label small fw-semibold" for="isActiveCheck">Ingrediente Activo</label>
          </div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <a href="{{ base_url }}/ingredients" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary text-white">Guardar Ingrediente</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
