{% extends "layouts/main.html.twig" %}

{% block title %}Editar Ingrediente{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-0">Editar Ingrediente</h3>
    <div class="text-muted small">Actualizar información de: {{ ingredient.name }}</div>
  </div>
  <a href="{{ base_url }}/ingredients" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Volver a Lista
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-pencil me-2 text-warning"></i>Modificar Insumo</h6>
      </div>
      <div class="card-body p-4">
        <form method="post" action="{{ base_url }}/ingredients/update/{{ ingredient.id }}">
          {{ csrf_field() }}

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Código *</label>
              <input type="text" name="code" class="form-control" value="{{ ingredient.code }}" required>
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Nombre del Ingrediente *</label>
              <input type="text" name="name" class="form-control" value="{{ ingredient.name }}" required>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Costo Compra ($) *</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="price_in" class="form-control" value="{{ ingredient.price_in }}" required>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Precio Referencial ($)</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" step="0.01" name="price_out" class="form-control" value="{{ ingredient.price_out }}">
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Unidad de Medida *</label>
              <input type="text" name="unit" class="form-control" value="{{ ingredient.unit }}" required>
            </div>
          </div>

          <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" name="is_active" id="isActiveCheck" {% if ingredient.is_active %}checked{% endif %}>
            <label class="form-check-label small fw-semibold" for="isActiveCheck">Ingrediente Activo</label>
          </div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <a href="{{ base_url }}/ingredients" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success text-white">Actualizar Ingrediente</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
