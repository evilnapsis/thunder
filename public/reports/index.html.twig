{% extends "layouts/main.html.twig" %}

{% block title %}Reporte de Ventas{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="fw-bold mb-0">Reporte de Ventas</h3>
    <div class="text-muted small">Corte de ventas por rango de fechas</div>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ base_url }}/reports/csv?start={{ start }}&finish={{ finish }}" class="btn btn-success text-white shadow-sm">
      <i class="bi bi-file-earmark-spreadsheet me-1"></i> Descargar CSV
    </a>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print();">
      <i class="bi bi-printer me-1"></i> Imprimir
    </button>
  </div>
</div>

<!-- Filtro de Fechas -->
<div class="card shadow-sm border-0 mb-3">
  <div class="card-body p-3">
    <form method="get" action="{{ base_url }}/reports" class="row g-2 align-items-end">
      <div class="col-sm-4 col-md-3">
        <label class="form-label small fw-semibold mb-1">Fecha Inicial</label>
        <input type="date" name="start" class="form-control form-control-sm" value="{{ start }}">
      </div>
      <div class="col-sm-4 col-md-3">
        <label class="form-label small fw-semibold mb-1">Fecha Final</label>
        <input type="date" name="finish" class="form-control form-control-sm" value="{{ finish }}">
      </div>
      <div class="col-sm-4 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <i class="bi bi-filter me-1"></i> Filtrar
        </button>
        <a href="{{ base_url }}/reports/csv?start={{ start }}&finish={{ finish }}" class="btn btn-success text-white" title="Exportar CSV">
          <i class="bi bi-download me-1"></i> CSV
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Resumen Total -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-md-4">
    <div class="card bg-success text-white border-0 shadow-sm">
      <div class="card-body p-3">
        <div class="small text-white-50 text-uppercase fw-semibold">Total Vendido</div>
        <div class="fs-4 fw-bold mt-1">${{ totalSales|number_format(2) }}</div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-md-4">
    <div class="card bg-info text-white border-0 shadow-sm">
      <div class="card-body p-3">
        <div class="small text-white-50 text-uppercase fw-semibold">Ventas Realizadas</div>
        <div class="fs-4 fw-bold mt-1">{{ orders|length }}</div>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3">
    <h6 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-primary"></i>Ventas</h6>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3"># Cuenta</th>
            <th>Mesa</th>
            <th>Comensales</th>
            <th>Fecha y Hora</th>
            <th class="text-end pe-3">Total Cobrado</th>
          </tr>
        </thead>
        <tbody>
          {% for o in orders %}
            {% set t = o.getTable() %}
            <tr>
              <td class="ps-3 fw-bold">#{{ o.id }}</td>
              <td>Mesa {{ t ? t.name : o.item_id }}</td>
              <td>{{ o.q }}</td>
              <td class="small">{{ o.created_at }}</td>
              <td class="text-end fw-bold text-success pe-3">${{ o.getTotal()|number_format(2) }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">No se registraron ventas en el periodo seleccionado.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
